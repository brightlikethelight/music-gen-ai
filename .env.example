# ── Environment ──────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # Must be false in production

# ── Model ────────────────────────────────────────────────────────────
MODEL_NAME=facebook/musicgen-small
DEVICE=auto                      # auto | cpu | cuda | cuda:0
OPTIMIZE=true
MODEL_CACHE_DIR=~/.cache/musicgen

# ── Generation limits ────────────────────────────────────────────────
MAX_DURATION=300
DEFAULT_DURATION=30
MAX_PROMPT_LENGTH=256

# ── API ──────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
TRUSTED_PROXY_IPS=               # Comma-separated list of trusted proxy IPs

# ── Storage ──────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
TEMP_DIR=                        # Defaults to system temp dir
JOB_RETENTION_HOURS=24

# ── Batch processing ────────────────────────────────────────────────
BATCH_MAX_WORKERS=4
BATCH_TIMEOUT=300
MAX_BATCH_SIZE=100

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ── Security / Auth ──────────────────────────────────────────────────
SECRET_KEY=                      # Auto-generated if empty; set a stable value for production
JWT_SECRET_KEY=                  # REQUIRED — at least 32 characters
MUSICGEN_ENV=development         # Used by secrets module
SECURE_HEADERS=true

# ── Redis (optional) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
MUSICGEN_SKIP_REDIS=false        # Set true to skip Redis connection
TOKEN_BLACKLIST_FAIL_POLICY=closed  # closed | open — behavior when Redis is down

# ── AWS (optional) ───────────────────────────────────────────────────
AWS_REGION=
S3_BUCKET=

# ── Testing ──────────────────────────────────────────────────────────
# PYTEST_CURRENT_TEST=1          # Set automatically by pytest
# MUSICGEN_SKIP_MODEL_DOWNLOAD=1 # Skip model downloads in CI/tests
