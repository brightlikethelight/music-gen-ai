# MusicGen Environment Configuration
# Copy to .env and fill in values before running

# Required
JWT_SECRET_KEY=change-me-to-a-random-32-char-string
GRAFANA_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Optional — Model
MODEL_NAME=facebook/musicgen-small
DEVICE=cpu

# Optional — API
LOG_LEVEL=INFO
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Optional — Security
TOKEN_BLACKLIST_FAIL_POLICY=closed
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
